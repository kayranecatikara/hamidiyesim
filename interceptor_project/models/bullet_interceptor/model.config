<?xml version="1.0"?>
<model>
  <name>bullet_interceptor</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>Interceptor Project</name>
    <email>hamidiyeavcidrone0@gmail.com</email>
  </author>

  <description>
    Bullet / rocket bodied high-speed C-UAS interceptor quadrotor.

    Vertical cylindrical fuselage (r = 0.08 m, h = 0.50 m, m = 1.8 kg) with four
    arms in an X configuration extending from the lower-middle of the body, a
    nose mounted forward/down looking target-lock camera, an IMU and the
    ArduPilot SITL plugin (ArduCopter Quad-X, FDM ports 9002/9003).

    Thrust-to-weight is tuned to ~7:1 so the airframe can sustain 200+ km/h
    intercept dashes.
  </description>
</model>
