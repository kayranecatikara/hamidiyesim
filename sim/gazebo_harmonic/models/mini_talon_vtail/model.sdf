    <plugin name="ArduPilotPlugin"
      filename="ArduPilotPlugin">
      <!-- Port settings. iris 9002 kullaniyor; Talon -I1 icin 9012. -->
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9012</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <have_32_channels>0</have_32_channels>

      <!-- Frame transforms.-->
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED>0 0 0 3.141593 0 1.57079632</gazeboXYZToNED>

      <!-- Sensors. -->
      <imuName>base_link::imu_sensor</imuName>

      <!--
          Joint range -30/+30 deg

          SERVO1_FUNCTION   4 (Aileron)
          SERVO1_MAX        2000
          SERVO1_MIN        1000
          SERVO1_REVERSED   0
          SERVO1_TRIM       1500
       -->
      <control channel="0">
        <jointName>left_aileron_joint</jointName>
        <multiplier>-1.0471976</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/left_aileron_joint/cmd_pos</cmd_topic>
      </control>

      <control channel="0">
        <jointName>right_aileron_joint</jointName>
        <multiplier>1.0471976</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/right_aileron_joint/cmd_pos</cmd_topic>
      </control>

      <!--
          Joint range -30/+30 deg

          SERVO2_FUNCTION   79 (Left V-Tail)
          SERVO2_MAX        2000
          SERVO2_MIN        1000
          SERVO2_REVERSED   0
          SERVO2_TRIM       1500
       -->
      <control channel="1">
        <jointName>left_ruddervator_joint</jointName>
        <multiplier>1.1868239</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/left_ruddervator_joint/cmd_pos</cmd_topic>
      </control>

      <!--
          SERVO3_FUNCTION   70 (Throttle)
          SERVO3_MAX        2000
          SERVO3_MIN        1000
          SERVO3_REVERSED   0
          SERVO3_TRIM       1000
       -->
      <control channel="2"> 
        <jointName>motor_joint</jointName>
        <!-- 2026-08-22: 1000 → 1080 rad/s = 10313 RPM. İki bağımsız kestirim:
             (a) 4500 gf statik itki + 13" pervane, Ct=0.095 → 10716 RPM
             (b) SunnySky X3520 528 KV × 25 V (6S) = 13200 boşta, yükte %75 → 9900
             Ortalaması. -->
        <multiplier>1080</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <!-- <type>COMMAND</type>
        <cmd_topic>/model/mini_talon_vtail/joint/motor_joint/cmd_vel</cmd_topic> -->

        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>1</i_max>
        <i_min>-1</i_min>
        <cmd_max>5.0</cmd_max>
        <cmd_min>-5.0</cmd_min>
      </control>

      <!--
          Joint range -30/+30 deg

          SERVO4_FUNCTION   80 (Right V-Tail)
          SERVO4_MAX        2000
          SERVO4_MIN        1000
          SERVO4_REVERSED   0
          SERVO4_TRIM       1500
       -->
      <control channel="3">
        <jointName>right_ruddervator_joint</jointName>
        <multiplier>1.1868239</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/right_ruddervator_joint/cmd_pos</cmd_topic>
      </control>

    </plugin>

  </model>
</sdf>

<!-- 
  Motor thrust calcs (initial estimates)

  PropDrive 3536 910kV motor
  3S battery (11.1V)
  rpm_max = 10000
  rpm = 8000
  ang_max = 1057
  ang_vel = 837
  10x7 prop

  Inertials

  fuselage:
  mass: 
  radius: 0.16 m
  length: 0.8 m

  main wheel:
  mass: 
  radius: 0.0135 m
  length: 0.014 m

  L/R wing
  mass: 
  area: 0.65 x 0.245 = 0.16 m^2
  cp: 

  L/R aileron
  mass:
  area: 0.237 x 0.0477 = 0.011 m^2
  cp: 

  L/R v-tail
  mass: 
  area: 0.126 x 0.197 = 0.025 m^2
  cp: 

  L/R ruddervator
  mass: 
  area: 0.042 x 0.154 = 0.0065 m^2
  cp: 

  Position and thrust controller commands

  Thrust:

  gz topic -t /model/mini_talon_vtail/joint/motor_joint/cmd_vel -m gz.msgs.Double -p 'data: 1000'

  Aileron:

  gz topic -t /right_aileron_joint/cmd_pos -m gz.msgs.Double -p 'data: 1'

  Ruddervator:

  gz topic -t /left_ruddervator_joint/cmd_pos -m gz.msgs.Double -p 'data: 1'

  -->

