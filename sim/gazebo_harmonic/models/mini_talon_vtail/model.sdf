      <collision name="motor_collision">
        <pose degrees="true">0 0 0.018 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0175</radius>
            <length>0.036</length>
          </cylinder>
        </geometry>
      </collision>
      <!-- ⛔ propeller_collision KALDIRILDI (2026-08-22) — KALKIŞI ENGELLİYORDU.
           13.7" pervanenin çarpışma diski yarıçapı 0.174 m; motor_link z = −0.040
           olduğu için diskin altı −0.214 m'ye iniyordu. Gövde altı ise −0.1995 m.
           Uçak gövdesine oturunca DÖNEN DİSK yere 1.5 cm GÖMÜLÜYORDU → uçak yerde
           dönüp durdu, tam gazda 60 s'de hava hızı 1.88 m/s'yi geçemedi
           (kara kutu 00000300.BIN).
           Neden silmek doğru: bu çarpışma gövdesi HİÇBİR temas sensöründe kayıtlı
           değil (temas_sensoru ve carpisma_sensoru yalnız gövde/kanat/kuyruk
           collision'larını sayar) — yani isabet tespitine katkısı YOK. Dönen bir
           pervaneyi katı çarpışma cismi yapmak zaten bu patolojiyi üretiyor.
           ⚠ GERÇEK ARAÇTA: 13.7" pervane itici (pusher) yerleşimde yerden kalkışta
           yere değer; gerçek Talon el ile fırlatılır. -->
      <visual name="motor_visual">
        <geometry>
          <mesh>
            <uri>model://mini_talon_vtail/meshes/propdrive_3536_motor_can.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name="propeller_visual">
        <pose degrees="true">0 0 -0.005 0 180 0</pose>
        <geometry>
          <mesh>
            <uri>model://mini_talon_vtail/meshes/iris_prop_cw.dae</uri>
            <!-- mesh 10.2" — gerçek pervane 13.7": 0.174/0.1295 = 1.3432.
                 YALNIZ GÖRSEL; vision/geometry.py collision STL okur, etkilenmez. -->
            <scale>1.2749 1.2749 1.2749</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.01 0.01 0.01 1</ambient>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <specular>0.01 0.01 0.01 1</specular>
        </material>
      </visual>
    </link>
    <joint name="motor_joint" type="revolute">
      <pose degrees="true">0 0 0 0 180 0</pose>
      <parent>base_link</parent>
      <child>motor_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.0e-16</lower>
          <upper>1.0e+16</upper>
        </limit>
        <dynamics>
          <damping>0.004</damping>
        </dynamics>
      </axis>
    </joint>

