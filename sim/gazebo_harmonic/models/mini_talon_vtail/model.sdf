      <!-- Sensors. -->
      <sensor name="imu_sensor" type="imu">
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>1</update_rate>
      </sensor>
      <!-- HEDEF İHA (Talon) burun kamerası — gcs "HEDEF İHA" sekmesini besler.
           Burunda, ileriye + hafif aşağı bakar (ufuk + zemin). -->
      <sensor name="talon_camera" type="camera">
        <gz_frame_id>base_link</gz_frame_id>
        <pose>0.46976563 0 0.067109375 0 -0.15 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>1</visualize>
        <topic>talon_cam/image</topic>
        <camera>
          <horizontal_fov>1.8</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>2000</far>
          </clip>
        </camera>
      </sensor>

      <!-- DIŞ GÖRÜŞ (chase) kamerası — GCS'te pencere olarak açılır.
           Talon'un ARKASINDAN/ÜSTÜNDEN bakar, hedef İHA kendisi kadrajdadır.
           Burun kamerasından farkı: bu görüntü hiçbir tespite/kilide girmez,
           ham yayınlanır (yalnız izleme).
           2.5 m arkada, 0.8 m yukarıda, ~18° aşağı (+0.31 rad) bakar:
           atan(0.8/2.5)=17.7° → gövde kadraj merkezine yakın oturur.
           gz-transport topic: talon_chase/image -->
      <sensor name="chase_camera" type="camera">
        <gz_frame_id>base_link</gz_frame_id>
        <pose>-3.3554688 0 1.07375 0 0.31 0</pose>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>0</visualize>
        <topic>talon_chase/image</topic>
        <camera>
          <horizontal_fov>1.4</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>2000</far>
          </clip>
        </camera>
      </sensor>

      <!-- A5 — GERÇEK ÇARPIŞMA SENSÖRÜ.
           Vuruş ölçütü artık "1.5 m'ye yaklaştı" değil, fiziksel temas.
           Yakınlık çarpışma değildir: bir koşuda 0.61 / 0.69 / 0.75 / 1.06 /
           1.16 / 1.20 m yaklaşma ölçüldü — eski ölçütle 6 SAHTE vuruş.

           ⚠ TEKERLEK BİLEREK YOK. main_wheel_collision main_wheel_link'te ve
           bu sensöre dahil edilmedi; tekerlek pistte sürekli yere değiyor,
           dahil edilseydi HER KALKIŞTA sahte çarpışma üretirdi.
           Zemin teması yine de gelebilir (gövde çakılması) — onu
           gcs_server'daki "karşı taraf iris değilse imha sayma" süzgeci eler.

           Dünya tarafında gz-sim-contact-system ZORUNLU (avci_harmonic.sdf);
           yoksa bu sensör sessizce hiçbir şey yayınlamaz. -->
      <sensor name="carpisma_sensoru" type="contact">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <contact>
          <collision>fuselage_collision</collision>
          <collision>left_wing_collision</collision>
          <collision>right_wing_collision</collision>
          <collision>left_tail_collision</collision>
          <collision>right_tail_collision</collision>
        </contact>
      </sensor>
    </link>

    <link name="main_wheel_link">
      <pose degrees="true">0.40536478 0 -0.13149948 90 0 0</pose>
      <inertial>
        <mass>0.013333334</mass>
        <inertia>
          <ixx>2.4474975e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.4474975e-06</iyy>
          <iyz>0</iyz>
          <izz>4.1103478e-06</izz>
        </inertia>
      </inertial>
      <collision name="main_wheel_collision">
        <geometry>
          <mesh>
            <uri>model://mini_talon_vtail/meshes/mini_talon_main_wheel_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="main_wheel_visual">
        <geometry>
          <mesh>
            <uri>model://mini_talon_vtail/meshes/mini_talon_main_wheel.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01</diffuse>
          <specular>0.01 0.01 0.01</specular>
          <pbr>
            <metal>
                <metalness>0.1</metalness>
                <roughness>0.8</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
    <joint name="main_wheel_joint" type="revolute">
      <pose degrees="true">0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>main_wheel_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.0e-16</lower>
          <upper>1.0e+16</upper>
        </limit>
        <dynamics>
          <damping>0.0001</damping>
        </dynamics>
      </axis>
    </joint>

    <link name="left_aileron_link">
      <pose degrees="true">-0.14361406 0.49795156 0.023354063 0 0 0</pose>
      <inertial>
        <mass>0.013333334</mass>
        <inertia>
          <ixx>0.00011247954</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>6.1049805e-06</iyy>
