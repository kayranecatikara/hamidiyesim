<?xml version="1.0"?>
<sdf version="1.9">
  <!--
    X-UAV TALON (1718 mm) — 2026-08-22'de Mini Talon'dan ölçeklendi.

    Ölçek çarpanı  s = 1718 / 1280 = 1.3421875   (düzgün/uniform)
    Araç: tools/mesh_olcekle.py    Geri alma: bayrak `geri`
    Orijinal (s=1.0) mesh'ler: models/_mesh_yedek/

    GERÇEK X-UAV Talon (üretici) | BU MODEL (collision mesh'ten ölçülen)
      kanat açıklığı  1.718 m    |  1.718 m
      gövde boyu      1.100 m    |  1.093 m   (−%0.66; en/boy oranı korundu)
      kanat alanı     0.60 m²    |  0.60 m²   (LiftDrag 2×0.30)
      uçuş ağırlığı   2.5-3.0 kg |  2.75 kg   (toplam: gövde 2.64 + parçalar)

    ⚠ AŞAĞIDAKİ ÖLÇÜLER ESKİ MİNİ TALON'A AİTTİR — ×1.3422 ile büyütüldü.
      (tarihsel kayıt; canlı değer değil)

    Mini-talon dimensions (s = 1.0, TARİHSEL)

    wing
    chord root: 0.248 m
    chord tip:  0.211 m
    span:       0.570 m
    area:       0.131 m^2

    aileron
    chord root: 0.0533 m
    chord tip:  0.0533 m
    span:       0.229 m
    area:       0.0122 m^2

    v-tail
    chord root: 0.1385 m
    chord tip:  0.0864 m
    span:       0.2 m
    area:       0.0225 m^2
  
    ruddervator
    chord root: 0.0479 m
    chord tip:  0.0349 m
    span:       0.147 m
    area:       0.061 m^2


  -->
  <model name="mini_talon_vtail">

    <link name="base_link">
      <inertial>
        <!-- AĞIRLIK MERKEZİ (2026-08-22, gerçek araçtan):
             batarya 900 g burundan ~10 cm geride (ÖNDE)
             motor   207 g gövde arkasında x=-0.550 (ARKADA)
             gerçek CG: kanat hücum kenarından 7.5 cm geride = x +0.0695
             gerçek aerodinamik merkez (çeyrek-veter) = x +0.0748
             → gerçek CG, aerodinamik merkezin 5.3 mm GERİSİNDE.
             Modelin kanat cp'si x=0 olduğu için aynı bağıl denge
             model CG = -0.0053 m demek. Toplam CG oraya oturtuldu. -->
        <pose>0.050402 0 0 0 0 0</pose>
        <mass>2.2263335</mass>
        <inertia>
          <ixx>0.059107217</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.20694208</iyy>
          <iyz>0</iyz>
          <izz>0.24939269</izz>
        </inertia>
      </inertial>

      <collision name="fuselage_collision">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mini_talon_vtail/meshes/mini_talon_fuselage_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <collision name="left_wing_collision">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mini_talon_vtail/meshes/mini_talon_left_wing_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <collision name="right_wing_collision">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mini_talon_vtail/meshes/mini_talon_right_wing_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <collision name="left_tail_collision">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mini_talon_vtail/meshes/mini_talon_left_tail_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <collision name="right_tail_collision">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mini_talon_vtail/meshes/mini_talon_right_tail_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <!-- Vuruş tespiti: gövde+kanat+kuyruk temaslarını yayınlar. Yer temasını
           control/sim_truth.py filtreler (yalnız iris'le temas vuruş sayılır).
           Dünyada gz-sim-contact-system eklentisi gerekir (avci_harmonic.sdf). -->
      <sensor name="temas_sensoru" type="contact">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <contact>
          <collision>fuselage_collision</collision>
          <collision>left_wing_collision</collision>
          <collision>right_wing_collision</collision>
          <collision>left_tail_collision</collision>
          <collision>right_tail_collision</collision>
        </contact>
      </sensor>

      <visual name="fuselage_visual">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mini_talon_vtail/meshes/mini_talon_fuselage.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
                <metalness>0.1</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="fuselage_logos_visual">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mini_talon_vtail/meshes/mini_talon_fuselage_logos.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
                <albedo_map>model://mini_talon_vtail/meshes/ardupilot_logo.png</albedo_map>
                <metalness>0.1</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="forward_deck_visual">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mini_talon_vtail/meshes/mini_talon_forward_deck.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
                <metalness>0.1</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="left_wing_visual">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mini_talon_vtail/meshes/mini_talon_left_wing.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
                <metalness>0.1</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="left_wing_logo_visual">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mini_talon_vtail/meshes/mini_talon_left_wing_logo.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
                <albedo_map>model://mini_talon_vtail/meshes/ardupilot_logo.png</albedo_map>
                <metalness>0.1</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="right_wing_visual">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mini_talon_vtail/meshes/mini_talon_right_wing.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
                <metalness>0.1</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="left_tail_visual">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mini_talon_vtail/meshes/mini_talon_left_tail.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
                <metalness>0.1</metalness>
