<?xml version="1.0" ?>
<!--
  Test hedefi: kucuk bir hedef drone yerine gecen 0.7 kg'lik kutu.

  NEDEN STATIK DEGIL:
  Ilk surumde <static>true</static> idi. NetCapturePlugin hedefi aga
  kilitleyince SONSUZ KUTLELI bir cisim agin eklem zincirine giriyor ve fizik
  sacmaliyor - 0.3 kg'lik ag, kutuyu havaya firlatiyordu. Gercek momentum
  korunumu icin hedefin de kutlesi olmali:
      ag 0.30 kg @ 20 m/s = 6.0 N.s
      hedef 0.70 kg  ->  ortak hiz = 6.0 / 1.00 = 6 m/s
  yani ag hedefi yakalayip birlikte suzulerek dusuyorlar - beklenen davranis.

  Dunyada ince bir statik direk uzerine oturtulur (test sirasinda havada
  dursun diye); ag carpinca direkten kurtulup agla birlikte gider.
-->
<sdf version="1.9">
  <model name="target_box">
    <link name="target_link">
      <inertial>
        <mass>0.7</mass>
        <!-- 0.5 x 0.5 x 0.4 m kutu icin: I = m(b^2+c^2)/12 -->
        <inertia>
          <ixx>0.0240</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0240</iyy>
          <iyz>0</iyz>
          <izz>0.0292</izz>
        </inertia>
      </inertial>

      <collision name="target_collision">
        <geometry><box><size>0.5 0.5 0.4</size></box></geometry>
        <surface>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
        </surface>
      </collision>

      <visual name="target_visual">
        <geometry><box><size>0.5 0.5 0.4</size></box></geometry>
        <material>
          <ambient>0.85 0.1 0.1 1</ambient>
          <diffuse>0.85 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <!-- Karsi taraftan da temas gorulebilsin -->
      <sensor name="target_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>1000</update_rate>
        <contact><collision>target_collision</collision></contact>
      </sensor>
    </link>
  </model>
</sdf>
