  <!-- Propellers {--><!-- Propeller 0 {-->
      <link name="prop_0_link">
    <pose>0.21213203435596423 -0.21213203435596423 0.01 0 0 0</pose>
    <inertial>
      <mass>0.0161</mass>
      <inertia>
        <ixx>0.00015305599166666665</ixx>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyy>0.00015305599166666665</iyy>
