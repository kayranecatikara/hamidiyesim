    <material>
      <script>
        <name>Gazebo/Black</name>
        <uri>file://media/materials/scripts/gazebo.material</uri>
      </script>
    </material>
  </visual>
    <collision name="prop_{{ motor_number }}_link_collision">
    <pose>0 0 0 0 1.5707963267948966 0</pose>
    <geometry>
      <cylinder>
        <length>0.39</length>
        <radius>0.01</radius>
      </cylinder>
    </geometry>
    <surface>
      <contact>
        <ode>
          <min_depth>0.01</min_depth>
          <max_vel>0.0</max_vel>
        </ode>
      </contact>
      <friction>
        <ode/>
      </friction>
    </surface>
  </collision>
  </link>
  <!-- <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel"> -->
  <plugin filename="MrsGazeboCommonResources_MulticopterMotorModel" name="gz::sim::systems::MrsMulticopterMotorModel">
    <jointName>prop_0_joint</jointName>
    <linkName>prop_0_link</linkName>
    <turningDirection>ccw</turningDirection>
    <timeConstantUp>0.0125</timeConstantUp>
    <timeConstantDown>0.025</timeConstantDown>
    <maxRotVelocity>780</maxRotVelocity>
    <motorConstant>5.6e-5</motorConstant>
    <momentConstant>0.06</momentConstant>
    <commandSubTopic>command/motor_speed</commandSubTopic>
    <actuator_number>0</actuator_number>
    <rotorDragCoefficient>1.0e-4</rotorDragCoefficient>
    <rollingMomentCoefficient>1.0e-6</rollingMomentCoefficient>
    <rotorVelocitySlowdownSim>12</rotorVelocitySlowdownSim>
    <motorType>velocity</motorType>
    <robotNamespace>cand_mrs_t650</robotNamespace>
  </plugin>
  <joint name="prop_0_joint" type="revolute">
    <parent>base_link</parent>
    <child>prop_0_link</child>
    <axis>
      <xyz>0 0 1</xyz>
      <limit>
        <lower>-1e+16</lower>
        <upper>1e+16</upper>
      </limit>
      <dynamics>
        <spring_reference>0</spring_reference>
        <spring_stiffness>0</spring_stiffness>
      </dynamics>
    </axis>
  </joint>
