  <model name="cand_mrs_naki">


    <link name="base_link">

      <!-- Body physics {-->
      <inertial>
    <mass>7.5</mass>
    <inertia>
      <ixx>0.1826875</ixx>
      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyy>0.1826875</iyy>
      <iyz>0</iyz>
      <izz>0.31537499999999996</izz>
    </inertia>
  </inertial>
  <collision name="base_link_collision">
    <pose>0 0 -0.0775 0 0 0</pose>
    <geometry>
      <cylinder>
        <length>0.155</length>
        <radius>0.47</radius>
      </cylinder>
    </geometry>
    <surface>
      <contact>
