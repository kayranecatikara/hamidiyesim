  <!-- <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel"> -->
  <plugin filename="MrsGazeboCommonResources_MulticopterMotorModel" name="gz::sim::systems::MrsMulticopterMotorModel">
    <jointName>prop_0_joint</jointName>
    <linkName>prop_0_link</linkName>
    <turningDirection>ccw</turningDirection>
    <timeConstantUp>0.0125</timeConstantUp>
    <timeConstantDown>0.025</timeConstantDown>
    <maxRotVelocity>1</maxRotVelocity>
    <motorConstant>23.44</motorConstant>
    <momentConstant>0.016</momentConstant>
    <commandSubTopic>command/motor_speed</commandSubTopic>
    <actuator_number>0</actuator_number>
    <rotorDragCoefficient>0.001</rotorDragCoefficient>
    <rollingMomentCoefficient>1.0e-6</rollingMomentCoefficient>
    <rotorVelocitySlowdownSim>0.0159236</rotorVelocitySlowdownSim>
    <motorType>velocity</motorType>
    <robotNamespace>cand_mrs_naki</robotNamespace>
  </plugin>
  <joint name="prop_0_joint" type="revolute">
    <parent>base_link</parent>
    <child>prop_0_link</child>
    <axis>
      <xyz>0 0 1</xyz>
      <limit>
        <lower>-1e+16</lower>
        <upper>1e+16</upper>
      </limit>
      <dynamics>
        <spring_reference>0</spring_reference>
        <spring_stiffness>0</spring_stiffness>
      </dynamics>
    </axis>
  </joint>
