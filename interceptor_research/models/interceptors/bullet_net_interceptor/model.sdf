<?xml version="1.0" ?>
<!--
  bullet_interceptor
  ==================
  High speed "bullet / rocket bodied" C-UAS interceptor quadrotor for
  Gazebo Garden / Harmonic + ArduPilot SITL (ArduCopter, Quad-X).

  Frame conventions (Gazebo model frame):
      +X : forward  (nose camera boresight)
      +Y : left
      +Z : up       (rocket nose points up)

  Layout:
      base_link  : vertical cylinder, r = 0.08 m, h = 0.50 m, m = 1.8 kg
                   spans z = -0.25 .. +0.25
      arms       : 4 booms at +/-45 deg azimuth, z = -0.10 (lower-middle)
      rotors     : 4 revolute rotors at radius 0.22 m, z = -0.06
      legs       : 4 skids reaching z = -0.28 (ground clearance 0.03 m)
      camera     : nose top, z = +0.24, pitched 15 deg down
      imu        : body centre

  ArduCopter Quad-X motor order (channel -> position -> rotation):
      channel 0 -> rotor_0 -> front right -> CCW  (multiplier > 0)
      channel 1 -> rotor_1 -> rear  left  -> CCW  (multiplier > 0)
      channel 2 -> rotor_2 -> front left  -> CW   (multiplier < 0)
      channel 3 -> rotor_3 -> rear  right -> CW   (multiplier < 0)
-->
<sdf version="1.9">
  <model name="bullet_net_interceptor">

    <!-- =================================================================
         FUSELAGE + ARMS + LEGS  (single rigid body)
         ================================================================= -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <!-- 1.8 kg solid cylinder, r = 0.08, h = 0.50, centred on the origin.
             Ixx = Iyy = (1/12) m (3r^2 + h^2) = 0.040380
             Izz       = (1/2)  m r^2          = 0.005760           -->
        <mass>1.8</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.040380</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.040380</iyy>
          <iyz>0</iyz>
          <izz>0.005760</izz>
        </inertia>
      </inertial>

      <!-- ========== fuselage ========== -->
      <collision name="fuselage_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.50</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="fuselage_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.50</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.12 0.13 0.16 1</ambient>
          <diffuse>0.18 0.20 0.24 1</diffuse>
          <specular>0.55 0.55 0.60 1</specular>
        </material>
      </visual>

      <!-- ========== burun konisi KALDIRILDI ==========
           Orijinalde z = +0.31'de r=0.08 / L=0.12 bir ogive koni vardi.
           Taret govdenin tepesine oturdugu icin cikarildi; govde tepesi
           artik z = +0.25'te duz bir tabla ve turret_base_link oraya biniyor.
           scripts/21_build_bullet_interceptor.py -->

      <!-- ========== boat tail (rear taper) ========== -->
      <visual name="tail_cone_visual">
        <pose>0 0 -0.28 3.14159265 0 0</pose>
        <geometry>
          <cone>
            <radius>0.08</radius>
            <length>0.06</length>
          </cone>
        </geometry>
        <material>
          <ambient>0.10 0.10 0.12 1</ambient>
          <diffuse>0.15 0.15 0.18 1</diffuse>
        </material>
      </visual>

      <!-- ========== identification band ========== -->
      <visual name="band_visual">
        <pose>0 0 0.16 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0815</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.70 0.45 0.00 1</ambient>
          <diffuse>1.00 0.65 0.00 1</diffuse>
        </material>
      </visual>

      <!-- =========== ARM 0 : FRONT RIGHT (-45 deg) =========== -->
      <visual name="arm_0_visual">
        <pose>0.098995 -0.098995 -0.10 0 1.5707963 -0.7853982</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
        </material>
      </visual>
      <collision name="arm_0_collision">
        <pose>0.098995 -0.098995 -0.10 0 1.5707963 -0.7853982</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="motor_pod_0_visual">
        <pose>0.155563 -0.155563 -0.085 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.020</radius>
            <length>0.045</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.28 1</ambient>
          <diffuse>0.40 0.40 0.45 1</diffuse>
        </material>
      </visual>
      <visual name="leg_0_visual">
        <pose>0.155563 -0.155563 -0.19 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
      <collision name="foot_0_collision">
        <pose>0.155563 -0.155563 -0.28 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.014</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="foot_0_visual">
        <pose>0.155563 -0.155563 -0.28 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.014</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>

      <!-- =========== ARM 1 : REAR LEFT (+135 deg) =========== -->
      <visual name="arm_1_visual">
        <pose>-0.098995 0.098995 -0.10 0 1.5707963 2.3561945</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
        </material>
      </visual>
      <collision name="arm_1_collision">
        <pose>-0.098995 0.098995 -0.10 0 1.5707963 2.3561945</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="motor_pod_1_visual">
        <pose>-0.155563 0.155563 -0.085 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.020</radius>
            <length>0.045</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.28 1</ambient>
          <diffuse>0.40 0.40 0.45 1</diffuse>
        </material>
      </visual>
      <visual name="leg_1_visual">
        <pose>-0.155563 0.155563 -0.19 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
      <collision name="foot_1_collision">
        <pose>-0.155563 0.155563 -0.28 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.014</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="foot_1_visual">
        <pose>-0.155563 0.155563 -0.28 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.014</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>

      <!-- =========== ARM 2 : FRONT LEFT (+45 deg) =========== -->
      <visual name="arm_2_visual">
        <pose>0.098995 0.098995 -0.10 0 1.5707963 0.7853982</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
        </material>
      </visual>
      <collision name="arm_2_collision">
        <pose>0.098995 0.098995 -0.10 0 1.5707963 0.7853982</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="motor_pod_2_visual">
        <pose>0.155563 0.155563 -0.085 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.020</radius>
            <length>0.045</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.28 1</ambient>
          <diffuse>0.40 0.40 0.45 1</diffuse>
        </material>
      </visual>
      <visual name="leg_2_visual">
        <pose>0.155563 0.155563 -0.19 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
      <collision name="foot_2_collision">
        <pose>0.155563 0.155563 -0.28 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.014</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="foot_2_visual">
        <pose>0.155563 0.155563 -0.28 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.014</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>

      <!-- =========== ARM 3 : REAR RIGHT (-135 deg) =========== -->
      <visual name="arm_3_visual">
        <pose>-0.098995 -0.098995 -0.10 0 1.5707963 -2.3561945</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
        </material>
      </visual>
      <collision name="arm_3_collision">
        <pose>-0.098995 -0.098995 -0.10 0 1.5707963 -2.3561945</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="motor_pod_3_visual">
        <pose>-0.155563 -0.155563 -0.085 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.020</radius>
            <length>0.045</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.28 1</ambient>
          <diffuse>0.40 0.40 0.45 1</diffuse>
        </material>
      </visual>
      <visual name="leg_3_visual">
        <pose>-0.155563 -0.155563 -0.19 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
      <collision name="foot_3_collision">
        <pose>-0.155563 -0.155563 -0.28 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.014</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="foot_3_visual">
        <pose>-0.155563 -0.155563 -0.28 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.014</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- =================================================================
         IMU
         ================================================================= -->
    <link name="imu_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.010</mass>
        <inertia>
          <ixx>1.0e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.0e-06</iyy>
          <iyz>0</iyz>
          <izz>1.0e-06</izz>
        </inertia>
      </inertial>

      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>imu_link</gz_frame_id>
        <pose>0 0 0 3.14159265 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000</update_rate>
        <!-- Deliberately NO <topic> override: the ArduPilot plugin derives the
             topic it subscribes to from the sensor's fully scoped entity name.
             Setting <topic> here makes the Imu system publish somewhere else,
             the plugin never receives data, and SITL sits forever printing
             "No JSON sensor message received, resending servos". -->
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <!-- =================================================================
         NOSE TARGET-LOCK CAMERA
         Mounted on the nose (z = +0.24), boresight along +X, pitched
         15 deg (0.2618 rad) downwards for target tracking / lock-on.
         ================================================================= -->
    <link name="camera_link">
      <pose>0.055 0 0.24 0 0.2617994 0</pose>
      <inertial>
        <mass>0.030</mass>
        <inertia>
          <ixx>1.0e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.0e-05</iyy>
          <iyz>0</iyz>
          <izz>1.0e-05</izz>
        </inertia>
      </inertial>

      <visual name="camera_housing_visual">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry>
          <cylinder>
            <radius>0.018</radius>
            <length>0.045</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <visual name="camera_lens_visual">
        <pose>0.024 0 0 0 1.5707963 0</pose>
        <geometry>
          <cylinder>
            <radius>0.013</radius>
            <length>0.006</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.00 0.10 0.20 1</ambient>
          <diffuse>0.05 0.30 0.55 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
        </material>
      </visual>

      <sensor name="target_lock_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>60</update_rate>
        <visualize>1</visualize>
        <topic>bullet_net_interceptor/nose_camera/image</topic>
        <camera name="nose_cam">
          <horizontal_fov>1.221730</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>3000</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
          <lens>
            <intrinsics>
              <fx>929.0</fx>
              <fy>929.0</fy>
              <cx>640.0</cx>
              <cy>360.0</cy>
              <s>0.0</s>
            </intrinsics>
          </lens>
          <optical_frame_id>camera_optical_frame</optical_frame_id>
        </camera>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- =================================================================
         ROTOR 0 : FRONT RIGHT, CCW  (ArduCopter Quad-X motor 1, channel 0)
         ================================================================= -->
    <link name="rotor_0">
      <pose>0.155563 -0.155563 -0.06 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>6.0e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>6.0e-05</iyy>
          <iyz>0</iyz>
          <izz>1.2e-04</izz>
        </inertia>
      </inertial>
      <visual name="rotor_0_hub">
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.010</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.30 0.30 0.30 1</ambient>
          <diffuse>0.50 0.50 0.50 1</diffuse>
        </material>
      </visual>
      <visual name="rotor_0_blade_1">
        <pose>0.070 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.10 0.028 0.004</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.30 0.05 1</ambient>
          <diffuse>0.10 0.60 0.10 1</diffuse>
        </material>
      </visual>
      <visual name="rotor_0_blade_2">
        <pose>-0.070 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.10 0.028 0.004</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.30 0.05 1</ambient>
          <diffuse>0.10 0.60 0.10 1</diffuse>
        </material>
      </visual>
      <collision name="rotor_0_collision">
        <geometry>
          <cylinder>
            <radius>0.120</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
