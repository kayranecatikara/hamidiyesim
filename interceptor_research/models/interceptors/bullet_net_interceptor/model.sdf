    <!-- =================================================================
         PLUGINS
         ================================================================= -->

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
    </plugin>

    <!-- ===============================================================
         Blade element aerodynamics: 2 lift/drag elements per rotor.
         area = 0.0025 m^2 and cp radius 0.084 m combined with the
         ArduPilot plugin multiplier of 1550 rad/s give roughly
             T_max = 4 * 2 * 0.5 * rho * (1550 * 0.084)^2 * A * (cla * a0)
                   ~= 172 N  ->  T/W ~= 8.7 : 1  (m_total = 1.915 kg)

         These same 8 elements are also the airframe's ONLY drag source (the
         fuselage has no lift_drag element on purpose), so they alone set the
         terminal dash speed. That speed is governed by the ratio of blade
         tangential speed to free-stream speed, NOT by how much peak thrust is
         available - measured in SITL:

             a0 0.30, cda 0.10, multiplier 1100  ->  196 km/h
             a0 0.30, cda 0.10, multiplier 1250  ->  201 km/h  (+29% thrust)
             a0 0.30, cda 0.06, multiplier 1250  ->  202 km/h  (-40% blade cd)
             a0 0.20, cda 0.10, multiplier 1550  ->  224 km/h  <== current

         Raising the multiplier alone barely helps: the flight controller just
         commands a smaller throttle fraction, so the rotor speed at cruise is
         unchanged. Lowering the blade pitch a0 and raising the multiplier to
         compensate keeps the same thrust but spins the blades faster, which
         is what actually pushes the terminal velocity up.

         CW rotors (2 and 3) use mirrored <forward> vectors so that a
         negative joint velocity still produces upward thrust.
         =============================================================== -->

    <!-- rotor_0 : CCW -->
    <plugin filename="gz-sim-lift-drag-system"
            name="gz::sim::systems::LiftDrag">
      <a0>0.20</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.0025</area>
      <air_density>1.2041</air_density>
      <cp>0.084 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_0</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system"
            name="gz::sim::systems::LiftDrag">
      <a0>0.20</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.0025</area>
      <air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_0</link_name>
    </plugin>

    <!-- rotor_1 : CCW -->
    <plugin filename="gz-sim-lift-drag-system"
            name="gz::sim::systems::LiftDrag">
      <a0>0.20</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.0025</area>
      <air_density>1.2041</air_density>
      <cp>0.084 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_1</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system"
            name="gz::sim::systems::LiftDrag">
      <a0>0.20</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.0025</area>
      <air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_1</link_name>
    </plugin>

    <!-- rotor_2 : CW (mirrored forward) -->
    <plugin filename="gz-sim-lift-drag-system"
            name="gz::sim::systems::LiftDrag">
      <a0>0.20</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.0025</area>
