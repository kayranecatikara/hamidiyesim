<?xml version='1.0'?>
<sdf version="1.9">
  <model name="avci_net_interceptor_display">
    <static>true</static>
    <include>
      <static>true</static>
      <uri>model://iris_with_standoffs</uri>
    </include>

    <!--
      visual markers for debugging
      - blade root    - teal
      - blade tip     - orange
      - blade cp      - yellow
      - blade forward - red
      - blade upward  - blue
    -->
