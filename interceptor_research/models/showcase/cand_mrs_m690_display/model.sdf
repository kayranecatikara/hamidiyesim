      <!-- Legs {-->
      <visual name="legs_visual">
    <pose>0 0 0 0 0 0</pose>
    <geometry>
      <mesh>
        <uri>model://mrs_robots_description/meshes/t_drones/m690b/t_drone_m690b_legs.stl</uri>
        <scale>1 1 1</scale>
      </mesh>
    </geometry>
    <material>
      <script>
        <name>Gazebo/Grey</name>
        <uri>file://media/materials/scripts/gazebo.material</uri>
      </script>
    </material>
  </visual>

      <collision name="leg_right_collision">
    <pose>0 0.165 -0.258 0 -1.5707963267948966 0</pose>
    <geometry>
      <cylinder>
        <length>0.3</length>
        <radius>0.01</radius>
      </cylinder>
    </geometry>
    <surface>
      <contact>
        <ode>
          <min_depth>0.01</min_depth>
          <max_vel>0.0</max_vel>
        </ode>
      </contact>
      <friction>
        <ode/>
      </friction>
    </surface>
  </collision>

      <collision name="leg_left_collision">
    <pose>0 -0.165 -0.258 0 -1.5707963267948966 0</pose>
    <geometry>
      <cylinder>
        <length>0.3</length>
        <radius>0.01</radius>
      </cylinder>
    </geometry>
