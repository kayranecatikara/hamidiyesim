<?xml version="1.0" encoding="utf-8"?>
<sdf version='1.10'>











  <model name="cand_mrs_m690_display">
    <static>true</static>


    <link name="base_link">

      <!-- Body visuals {-->

      <!-- Central board {-->
      <visual name="central_board_visual">
    <pose>0 0 0 0 0 0</pose>
    <geometry>
      <mesh>
        <uri>model://mrs_robots_description/meshes/t_drones/m690b/t_drone_m690b_central_body.stl</uri>
        <scale>1 1 1</scale>
      </mesh>
    </geometry>
    <material>
      <script>
        <name>Gazebo/Grey</name>
        <uri>file://media/materials/scripts/gazebo.material</uri>
      </script>
    </material>
  </visual>
      <!--}-->

      <!-- Arms {-->
      <visual name="arm_back_right_visual">
    <pose>0 0 0 0 0 0</pose>
    <geometry>
      <mesh>
        <uri>model://mrs_robots_description/meshes/t_drones/m690b/t_drone_m690b_arm.stl</uri>
        <scale>1 1 1</scale>
