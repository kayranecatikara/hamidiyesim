<?xml version="1.0" ?>
<!--
  Ag firlatma test dunyasi (Asama 3-4-5).

  Icerik:
    - avci_net_interceptor : taretli interceptor, yerde duruyor
    - net_cone             : namlunun ucuna DetachableJoint ile bagli
    - target_box           : 10 m ileride, 2 m yukseklikte statik hedef

  Konumlandirma matematigi (interceptor modeli 0 0 0.2'de):
    namlu ucu   = model cercevesinde x = 0.16 + 0.06 + 0.05 = 0.27
    net_link    = koninin TEPESI  -> namlu ucunun 0.01 m onune, x = 0.28
                  koni oradan +X'e 0.25 m acilir (agiz x = 0.53)
    dunya       = 0.28 + 0 = 0.28 ,  z = 0.2 + 0.045 = 0.245

  Kullanim:
    scripts/30_run_net_test.sh          (dunyayi acar)
    python3 scripts/turret_aim.py 20 -5 (tareti dondurur)
    python3 scripts/fire_net.py         (agi atar)
-->
<sdf version="1.9">
  <world name="net_test">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>
    <plugin filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- Ag temasini yakalamak icin sart -->
    <plugin filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>
    <!--
      NOT: apply-link-wrench ARTIK KULLANILMIYOR. Firlatma islemi
      NetLauncherPlugin'e tasindi (interceptor modelinin icinde) - ayirma ve
      hiz verme ayni fizik adiminda yapiliyor. Disaridan wrench yollamak
      tekrarlanabilir menzil vermiyordu.
    -->

    <!--
      Yakalama: agin temas ettigi hedefi calisma aninda ona kilitler.
      Kendi eklentimiz (plugins/NetCapturePlugin.cc) - Harmonic'te hazir
      "calisma aninda baglama" sistemi olmadigi icin yazildi.
    -->
    <plugin filename="NetCapturePlugin" name="avci::NetCapturePlugin">
      <net_model>net_cone</net_model>
      <net_link>net_link</net_link>
      <target_model>target_box</target_model>
      <capture_topic>/net/captured</capture_topic>
      <!-- Ag namluda dururken hedefe degip kazara kilitlenmesin -->
      <min_speed>1.0</min_speed>
    </plugin>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.5 0.5 0.5</ambient>
      <background>0.6 0.7 0.9</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
          <material>
            <ambient>0.3 0.45 0.3 1</ambient>
            <diffuse>0.3 0.45 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Menzil olcumu icin her 5 m'de bir isaret direk -->
    <model name="range_markers">
      <static>true</static>
      <link name="link">
        <visual name="m5">
          <pose>5 0 1 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>2</length></cylinder></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
        <visual name="m10">
          <pose>10 0 1 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>2</length></cylinder></geometry>
          <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
        </visual>
        <visual name="m15">
          <pose>15 0 1 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>2</length></cylinder></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
        <visual name="m20">
          <pose>20 0 1 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>2</length></cylinder></geometry>
          <material><ambient>0.6 0 0.6 1</ambient><diffuse>0.6 0 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://avci_net_interceptor</uri>
      <name>avci_net_interceptor</name>
      <pose>0 0 0.2 0 0 0</pose>
    </include>

    <include>
      <uri>model://net_cone</uri>
      <name>net_cone</name>
      <pose>0.28 0 0.245 0 0 0</pose>
    </include>


    <!--
      Hedef direği: target_box artik DINAMIK (0.7 kg), yoksa yere duserdi.
      Ag carpinca kutu direkten kurtulup agla birlikte gider.
    -->
    <model name="target_pole">
      <static>true</static>
      <pose>3 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0.225 0 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.45</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.225 0 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.45</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://target_box</uri>
      <name>target_box</name>
      <!--
        3 m / 0.35 m: interceptor bu dunyada YERDE duruyor (namlu z=0.26 m),
        atilan ag ~0.25 sn sonra yere iniyor. Hedef 10 m'de olsaydi ag ona hic
        ulasamazdi. Buradaki amac temas/ayirma zincirini dogrulamak.
        Havada gercek angajman: Asama 7, intercept_test.sdf (ArduPilot SITL).
      -->
      <!--
        z=0.65: yerden -8 derece tiltle atilan agin x=3 m'deki olculen
        yuksekligi 0.70 m (docs/bench_raw/net_trajectory.csv). z=0.35'te
        birakildiginda ag hedefin ~0.3 m ustunden geciyordu.
      -->
      <pose>3 0 0.65 0 0 0</pose>
    </include>

    <!-- Aksiyon kamerasi: 52_action_shots.py bundan kare alir -->
    <model name="action_camera">
      <static>true</static>
      <!-- x=4 civarina bakan yan gorus: drone (x=0) ve hedef (x=3) kadrajda -->
      <pose>4.0 -8.0 1.9 0 0.02 1.5708</pose>
      <link name="link">
        <sensor name="cam" type="camera">
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <topic>/action/view</topic>
          <camera>
            <horizontal_fov>1.15</horizontal_fov>
            <image><width>1440</width><height>810</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>200</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
