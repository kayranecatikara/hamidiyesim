<?xml version="1.0" ?>
<!--
  VITRIN DUNYASI - scripts/50_showcase.py tarafindan uretildi, elle duzenlemeyin.

  Tum interceptor adaylari yan yana, 1.2 m yukseklikte asili.
  Soldan saga (kaide rengi):
    1. AVCI NET INTERCEPTOR (taretli+ag)
    2. cand_iris (secilen govde)
    3. cand_iq_camera (iq_sim)
    4. cand_mrs_x500 (CTU MRS)
    5. cand_mrs_t650 (CTU MRS)
    6. cand_mrs_m690 (CTU MRS)
    7. cand_mrs_f450 (CTU MRS)
    8. cand_mrs_naki (CTU MRS)

  Kullanim:
    source scripts/env.sh
    gz sim -r worlds/showcase.sdf          # canli GUI
    python3 scripts/51_capture_shots.py    # ekran goruntusu
-->
<sdf version="1.9">
  <world name="showcase">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.75 0.75 0.78 1</ambient>
      <background>0.55 0.68 0.85 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.3 -0.85</direction>
    </light>
    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.45 0.45 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.6 -0.5 -0.6</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.42 0.44 0.46 1</ambient>
            <diffuse>0.42 0.44 0.46 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ag, taretin namlusunda -->
    <include>
      <static>true</static>
      <uri>model://net_cone_display</uri>
      <name>net_cone_display</name>
      <pose>-6.37 0 1.245 0 0 0</pose>
    </include>
    <!-- AVCI NET INTERCEPTOR (taretli+ag) -->
    <include>
      <uri>model://avci_net_interceptor_display</uri>
      <name>avci_net_interceptor_display</name>
      <pose>-6.65 0 1.2 0 0 0</pose>
    </include>

    <!-- avci_net_interceptor kaidesi ve renk kodu -->
    <model name="avci_net_interceptor_pedestal">
      <static>true</static>
      <pose>-6.65 0 0 0 0 0</pose>
      <link name="link">
        <visual name="post">
          <pose>0 0 0.60 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>1.20</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
        <visual name="base">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.45</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.9 0.4 0.05 1</ambient><diffuse>0.9 0.4 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- cand_iris (secilen govde) -->
    <include>
      <uri>model://cand_iris_display</uri>
      <name>cand_iris_display</name>
      <pose>-4.75 0 1.2 0 0 0</pose>
    </include>

    <!-- cand_iris kaidesi ve renk kodu -->
    <model name="cand_iris_pedestal">
      <static>true</static>
      <pose>-4.75 0 0 0 0 0</pose>
      <link name="link">
        <visual name="post">
          <pose>0 0 0.60 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>1.20</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
        <visual name="base">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.45</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.2 0.7 0.2 1</ambient><diffuse>0.2 0.7 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- cand_iq_camera (iq_sim) -->
    <include>
      <uri>model://cand_iq_camera_display</uri>
      <name>cand_iq_camera_display</name>
      <pose>-2.85 0 1.2 0 0 0</pose>
    </include>

    <!-- cand_iq_camera kaidesi ve renk kodu -->
    <model name="cand_iq_camera_pedestal">
      <static>true</static>
      <pose>-2.85 0 0 0 0 0</pose>
      <link name="link">
        <visual name="post">
          <pose>0 0 0.60 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>1.20</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
        <visual name="base">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.45</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.2 0.5 0.9 1</ambient><diffuse>0.2 0.5 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- cand_mrs_x500 (CTU MRS) -->
    <include>
      <uri>model://cand_mrs_x500_display</uri>
      <name>cand_mrs_x500_display</name>
      <pose>-0.95 0 1.2 0 0 0</pose>
    </include>

    <!-- cand_mrs_x500 kaidesi ve renk kodu -->
    <model name="cand_mrs_x500_pedestal">
      <static>true</static>
      <pose>-0.95 0 0 0 0 0</pose>
      <link name="link">
        <visual name="post">
          <pose>0 0 0.60 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>1.20</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
        <visual name="base">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.45</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- cand_mrs_t650 (CTU MRS) -->
    <include>
      <uri>model://cand_mrs_t650_display</uri>
      <name>cand_mrs_t650_display</name>
      <pose>0.95 0 1.2 0 0 0</pose>
    </include>

    <!-- cand_mrs_t650 kaidesi ve renk kodu -->
    <model name="cand_mrs_t650_pedestal">
      <static>true</static>
      <pose>0.95 0 0 0 0 0</pose>
      <link name="link">
        <visual name="post">
          <pose>0 0 0.60 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>1.20</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
        <visual name="base">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.45</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- cand_mrs_m690 (CTU MRS) -->
    <include>
      <uri>model://cand_mrs_m690_display</uri>
      <name>cand_mrs_m690_display</name>
      <pose>2.85 0 1.2 0 0 0</pose>
    </include>

    <!-- cand_mrs_m690 kaidesi ve renk kodu -->
    <model name="cand_mrs_m690_pedestal">
      <static>true</static>
      <pose>2.85 0 0 0 0 0</pose>
      <link name="link">
        <visual name="post">
          <pose>0 0 0.60 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>1.20</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
        <visual name="base">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.45</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- cand_mrs_f450 (CTU MRS) -->
    <include>
      <uri>model://cand_mrs_f450_display</uri>
      <name>cand_mrs_f450_display</name>
      <pose>4.75 0 1.2 0 0 0</pose>
    </include>

    <!-- cand_mrs_f450 kaidesi ve renk kodu -->
    <model name="cand_mrs_f450_pedestal">
      <static>true</static>
      <pose>4.75 0 0 0 0 0</pose>
      <link name="link">
        <visual name="post">
          <pose>0 0 0.60 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>1.20</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
        <visual name="base">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.45</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- cand_mrs_naki (CTU MRS) -->
    <include>
      <uri>model://cand_mrs_naki_display</uri>
      <name>cand_mrs_naki_display</name>
      <pose>6.65 0 1.2 0 0 0</pose>
    </include>

    <!-- cand_mrs_naki kaidesi ve renk kodu -->
    <model name="cand_mrs_naki_pedestal">
      <static>true</static>
      <pose>6.65 0 0 0 0 0</pose>
      <link name="link">
        <visual name="post">
          <pose>0 0 0.60 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>1.20</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
        <visual name="base">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.45</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Vitrin kamerasi: 51_capture_shots.py bundan goruntu alir -->
    <model name="showcase_camera">
      <static>true</static>
      <pose>0 -11.5 1.75 0 0.035 1.5708</pose>
      <link name="link">
        <sensor name="cam" type="camera">
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>/showcase/wide</topic>
          <camera>
            <horizontal_fov>1.25</horizontal_fov>
            <image><width>1800</width><height>620</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>200</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- Yakin plan kamera: taretli interceptor -->
    <model name="closeup_camera">
      <static>true</static>
      <!-- Taretli interceptor en solda: x = -(n-1)*ARALIK/2 = -6.65 -->
      <pose>-6.45 -2.05 1.30 0 -0.01 1.5708</pose>
      <link name="link">
        <sensor name="cam" type="camera">
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>/showcase/closeup</topic>
          <camera>
            <horizontal_fov>0.80</horizontal_fov>
            <image><width>1280</width><height>1000</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>100</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
