<?xml version="1.0" ?>
<!--
  SKYCAT TVBS PIST DUNYASI

  ArduPilot/SITL_Models'taki Gazebo/worlds/skycat_runway.sdf'in projeye alinmis
  hali. Ustteki farklar:
    - gz-sim-sensors-system + iki sabit kamera (headless ekran goruntusu icin;
      51_capture_shots.py bu topic'lere abone oluyor)
    - runway modeli ardupilot_gazebo/models'tan geliyor (env.sh)

  Model ArduPilotPlugin tasiyor ve lock_step=1: SITL baglanmadan fizik
  ILERLEMEZ. Yani bu dunya tek basina calistirilinca donmus gorunur, bu normal.

  Kullanim:
    source scripts/env.sh
    gz sim -r worlds/skycat_runway.sdf                       # 1. terminal
    ./scripts/71_skycat_sitl.sh                              # 2. terminal (SITL)
-->
<sdf version="1.7">
  <world name="skycat_runway">
    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <sky></sky>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <pose degrees="true">-29 545 0 0 0 363</pose>
      <uri>model://runway</uri>
    </include>

    <include>
      <pose degrees="true">0 0 0.15 0 0 90</pose>
      <uri>model://skycat_tvbs</uri>
    </include>

    <!-- Kalkis kamerasi: pistin yanindan, 0-25 m irtifayi cerceveler -->
    <model name="cam_kalkis">
      <static>true</static>
      <pose degrees="true">-14 -10 4.0 0 8 35</pose>
      <link name="link">
        <sensor name="cam" type="camera">
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>/skycat/kalkis</topic>
          <camera>
            <horizontal_fov>1.05</horizontal_fov>
            <image><width>1600</width><height>1100</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>800</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- Yakin plan: yerdeki / alcak irtifadaki araci yandan gorur -->
    <model name="cam_yakin">
      <static>true</static>
      <pose degrees="true">-3.5 -4.5 1.1 0 3 52</pose>
      <link name="link">
        <sensor name="cam" type="camera">
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>/skycat/yakin</topic>
          <camera>
            <horizontal_fov>1.0</horizontal_fov>
            <image><width>1600</width><height>1100</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>500</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
