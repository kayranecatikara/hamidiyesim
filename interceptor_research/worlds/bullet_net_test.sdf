<?xml version="1.0" ?>
<!--
  Mermi govdeli taretli interceptor icin ag firlatma test dunyasi.
  net_test.sdf'in bullet_net_interceptor'a uyarlanmis hali.

  Icerik:
    - bullet_net_interceptor : dikey mermi govde, TEPESINDE taret, yerde duruyor
    - net_cone               : namlunun ucuna DetachableJoint ile bagli
    - target_box             : 3 m ileride, direge oturtulmus dinamik hedef

  Konumlandirma matematigi:
    ayak kureleri model cercevesinde z = -0.28, r = 0.014 -> alt nokta -0.294
      => model z = 0.30'da ayaklar yere basar (0.006 m pay)
    taret montaji  = govde tepesi z = +0.25  (burun konisi kaldirildi)
    namlu merkezi  = model cercevesinde x = 0.06 , z = 0.265 + 0.045 = 0.31
    namlu ucu      = x = 0.06 + 0.05 = 0.11
    net_link       = koninin TEPESI -> namlu ucunun 0.01 m onune, x = 0.12
    dunya          = net_cone (0.12 , 0 , 0.30 + 0.31 = 0.61)

  Kullanim:
    source scripts/env.sh
    gz sim -r worlds/bullet_net_test.sdf
    python3 scripts/turret_aim.py 0 -8 --model bullet_net_interceptor
    python3 scripts/fire_net.py --hiz 20 --model bullet_net_interceptor
-->
<sdf version="1.9">
  <world name="bullet_net_test">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>
    <plugin filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>

    <plugin filename="NetCapturePlugin" name="avci::NetCapturePlugin">
      <net_model>net_cone</net_model>
      <net_link>net_link</net_link>
      <target_model>target_box</target_model>
      <capture_topic>/net/captured</capture_topic>
      <min_speed>1.0</min_speed>
    </plugin>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.5 0.5 0.5</ambient>
      <background>0.6 0.7 0.9</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
          <material>
            <ambient>0.3 0.45 0.3 1</ambient>
            <diffuse>0.3 0.45 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Menzil olcumu icin her 5 m'de bir isaret direk -->
    <model name="range_markers">
      <static>true</static>
      <link name="link">
        <visual name="m5">
          <pose>5 0 1 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>2</length></cylinder></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
        <visual name="m10">
          <pose>10 0 1 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>2</length></cylinder></geometry>
          <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
        </visual>
        <visual name="m15">
          <pose>15 0 1 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>2</length></cylinder></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
        <visual name="m20">
          <pose>20 0 1 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>2</length></cylinder></geometry>
          <material><ambient>0.6 0 0.6 1</ambient><diffuse>0.6 0 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://bullet_net_interceptor</uri>
      <name>bullet_net_interceptor</name>
      <pose>0 0 0.30 0 0 0</pose>
    </include>

    <include>
      <uri>model://net_cone</uri>
      <name>net_cone</name>
      <pose>0.12 0 0.61 0 0 0</pose>
    </include>

    <!--
      Hedef diregi. Namlu bu dunyada z = 0.61'de (net_test.sdf'te 0.245 idi),
      yani mermi govde agzi 0.365 m daha yuksek: hedef de o kadar yukseldi.
      Kesin yukseklik olculen yorunge ile ayarlandi (asagidaki nota bakin).
    -->
    <model name="target_pole">
      <static>true</static>
      <pose>3 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0.40 0 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.80</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.40 0 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.80</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://target_box</uri>
      <name>target_box</name>
      <!-- z: 0 derece tiltle atilan agin x=3 m'deki OLCULEN yuksekligi -->
      <pose>3 0 1.00 0 0 0</pose>
    </include>

    <!-- Aksiyon kamerasi: 52_action_shots.py bundan kare alir -->
    <model name="action_camera">
      <static>true</static>
      <pose>3.0 -7.0 1.4 0 0.02 1.5708</pose>
      <link name="link">
        <sensor name="cam" type="camera">
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <topic>/action/view</topic>
          <camera>
            <horizontal_fov>1.15</horizontal_fov>
            <image><width>1440</width><height>810</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>200</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
